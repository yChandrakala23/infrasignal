# Copy to .env and replace every CHANGE_ME value. The app refuses to start while a CHANGE_ME value is set.

# --- database -------------------------------------------------------------
# PostgreSQL + PostGIS (docker compose):
DATABASE_URL=postgresql+psycopg2://infra:infra@db:5432/infrasignal
# Running without Docker / without PostgreSQL? Use SQLite (shapely does the spatial work):
# DATABASE_URL=sqlite:///./infrasignal.db

# --- security -------------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret      # python -c "import secrets;print(secrets.token_urlsafe(48))"
# Accounts are created at start-up ONLY for the variables you set. Citizens never need an account.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=CHANGE_ME_admin_password          # sees contact details, manages users, loads sample data
OFFICER_EMAIL=officer@example.org
OFFICER_PASSWORD=CHANGE_ME_officer_password      # Government Monitoring: documents, imports, matching review
AUTHORITY_EMAIL=authority@example.org
AUTHORITY_PASSWORD=CHANGE_ME_authority_password  # Authority Dashboard: clusters, alerts, report status

# --- storage ---------------------------------------------------------------
UPLOAD_DIR=uploads                  # citizen photos (private; never served publicly)
DOCUMENT_DIR=data/uploads/documents # government PDFs

# --- behaviour -------------------------------------------------------------
AUTO_SEED_SAMPLE=                   # set to 1 to load the labelled SAMPLE data when the database is empty
REPORT_RATE_PER_HOUR=5              # citizen submissions per client per hour
ROAD_SNAP_M=60                      # a report is attached to a road if a segment is within this many metres
CLUSTER_EPS_M=40                    # clustering radius
CLUSTER_WINDOW_DAYS=60              # reports further apart in time are not grouped
ALERT_MIN_CLUSTER=3                 # default for the 'multiple reports' alert (editable in the Authority Dashboard)
SEMANTIC_BACKEND=                   # empty = built-in TF-IDF + concept tokens; 'sbert' = sentence-transformers (pip install it first)
# ANTHROPIC_API_KEY=                # optional LLM-assisted extraction (values are still checked against the page text)
# LLM_MODEL=claude-sonnet-5-5
