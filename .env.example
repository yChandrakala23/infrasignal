# Copy to .env and replace every CHANGE_ME value before starting the app.
DATABASE_URL=postgresql+psycopg2://infra:infra@db:5432/infrasignal
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
ADMIN_EMAIL=admin@infrasignal.demo
ADMIN_PASSWORD=CHANGE_ME_admin_password
OFFICER_EMAIL=officer@infrasignal.demo
OFFICER_PASSWORD=CHANGE_ME_officer_password
CLUSTER_EPS_M=40
CLUSTER_WINDOW_DAYS=60
ALERT_MIN_CLUSTER=3
UPLOAD_DIR=uploads
