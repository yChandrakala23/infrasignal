# Easiest: run  python -m scripts.make_env  from the backend folder; it writes .env with random secrets.
# Or copy this file to .env and replace every CHANGE_ME value. The app refuses to start while a CHANGE_ME value is set.

# --- database -------------------------------------------------------------
# PostgreSQL + PostGIS (docker compose):
DATABASE_URL=postgresql+psycopg2://infra:infra@db:5432/infrasignal
# Running without Docker / without PostgreSQL? Use SQLite (shapely does the spatial work):
# DATABASE_URL=sqlite:///./infrasignal.db

# --- security -------------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret      # python -c "import secrets;print(secrets.token_urlsafe(48))"
# Accounts are created at start-up ONLY for the variables you set. Citizens never need an account.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=CHANGE_ME_admin_password          # sees contact details, manages users, loads sample data
OFFICER_EMAIL=officer@example.org
OFFICER_PASSWORD=CHANGE_ME_officer_password      # Government Monitoring: documents, imports, matching review
AUTHORITY_EMAIL=authority@example.org
AUTHORITY_PASSWORD=CHANGE_ME_authority_password  # Authority Dashboard: clusters, alerts, report status

# --- storage ---------------------------------------------------------------
UPLOAD_DIR=uploads                  # citizen photos (private; never served publicly)
DOCUMENT_DIR=data/uploads/documents # government PDFs

# --- behaviour -------------------------------------------------------------
AUTO_SEED_SAMPLE=                   # set to 1 to load the labelled SAMPLE data when the database is empty
REPORT_RATE_PER_HOUR=5              # citizen submissions per client per hour
ROAD_SNAP_M=60                      # a report is attached to a road if a segment is within this many metres
CLUSTER_EPS_M=40                    # clustering radius
CLUSTER_WINDOW_DAYS=60              # reports further apart in time are not grouped
ALERT_MIN_CLUSTER=3                 # default for the 'multiple reports' alert (editable in the Authority Dashboard)
SEMANTIC_BACKEND=                   # empty = built-in TF-IDF + concept tokens; 'sbert' = sentence-transformers (pip install it first)
OCR_LANG=auto                       # scanned pages: auto | eng | kan | eng+kan  (kan needs: apt install tesseract-ocr-kan)
OCR_MIN_CONFIDENCE=70               # OCR pages below this mean word confidence (0-100) are flagged for manual correction
# OCR_DPI=                          # force the render resolution for OCR (default: 300, up to 400 for fine scans)
# ANTHROPIC_API_KEY=                # optional LLM-assisted extraction (values are still checked against the page text)
# LLM_MODEL=claude-sonnet-5-5

# --- BBMP automated collection (see docs/BBMP_COLLECTION.md) ---------------
# BBMP_SOURCES_FILE=                # another sources file (default: backend/data/bbmp_sources.json)
# BBMP_ALLOWED_HOSTS=data.opencity.in,site.bbmp.gov.in
# BBMP_USE_PLAYWRIGHT=0             # 1 = render pages that need JavaScript (pip install playwright && playwright install chromium)
# BBMP_DOWNLOAD_DIR=                # default: UPLOAD_DIR/bbmp
# BBMP_MAX_FAILED_FRACTION=0.5      # a file with more rejected rows than this is rolled back
# BBMP_RUN_LOCK_MINUTES=120         # a run "running" for longer is treated as interrupted
# BBMP_USER_AGENT=
# BBMP_SCHEDULE_ENABLED=0           # 1 = collect on a schedule (can also be set on the Collected data page)
# BBMP_SCHEDULE_CRON=0 3 * * 0      # standard 5-field cron, 0 = Sunday
# BBMP_SCHEDULE_TZ=Asia/Kolkata

# --- live web crawling (primary collection: GBA / BBMP website and portals in data/bbmp_sources.json -> crawl_sources)
WEB_CRAWL_ON_SCHEDULE=1             # the scheduled collection also crawls the websites (set 0 to only read the OpenCity datasets)
WEB_MAX_DOCUMENTS=40                # documents downloaded per source per run (the rest wait for the next run)
BBMP_ALLOWED_HOSTS=data.opencity.in,site.bbmp.gov.in,bbmp.gov.in,updates.bbmpgov.in
BBMP_USE_PLAYWRIGHT=0               # 1 = render pages whose links appear only after JavaScript (pip install playwright && playwright install chromium)
TESSERACT_CMD=                      # Windows: full path to tesseract.exe if it is not on PATH (C:\Program Files\Tesseract-OCR\tesseract.exe is found automatically)
BBMP_USE_CKAN_API=1                 # read OpenCity datasets through the CKAN API (0 = read the dataset web pages instead)
